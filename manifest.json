{
  "manifest_version": 3,
  "name": "CoachMate Slow Down",
  "short_name": "Slow Down",
  "version": "1.2.0",
  "description": "Waits for you after every opponent move, sized to the time control, so you stop moving too soon. Part of CoachMate.",
  "homepage_url": "https://www.coachmatechess.com",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CoachMate Slow Down",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "content/core.js",
        "content/lichess.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "content/core.js",
        "content/chesscom.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/mark.webp"
      ],
      "matches": [
        "https://lichess.org/*",
        "https://www.chess.com/*",
        "https://chess.com/*"
      ]
    }
  ]
}
